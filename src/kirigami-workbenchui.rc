<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="kirigami-workbench" version="3">
  <MenuBar>
    <Menu name="file">
      <text>&amp;File</text>
      <Action name="file_save"/>
      <Action name="file_new_component"/>
      <Separator/>
      <Action name="file_close_tab"/>
    </Menu>
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="toggle_gallery"/>
      <Separator/>
      <Action name="next_tab"/>
      <Action name="previous_tab"/>
    </Menu>
    <Merge name="settings"/>
    <Merge name="help"/>
  </MenuBar>
</gui>
